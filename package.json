{
  "name": "x-multi-workspace",
  "version": "1.1.1",
  "private": true,
  "description": "Local multi-account X workspace for Windows",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch\" \"wait-on http://127.0.0.1:5173 dist/main/main.js && electron .\"",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run src",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.main.json",
    "dist:win": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.2",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "local.xmultiworkspace.app",
    "productName": "X Multi Workspace",
    "directories": {"output": "outputs", "buildResources": "build"},
    "files": ["dist/**/*", "package.json"],
    "asar": true,
    "compression": "store",
    "win": {"target": ["nsis", "portable"], "icon": "build/icon.svg"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "X-Multi-Workspace-Setup-${version}-${arch}.${ext}"},
    "portable": {"artifactName": "X-Multi-Workspace-Portable-${version}-${arch}.${ext}"}
  }
}
